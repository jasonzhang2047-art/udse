  "revision": 1,
  "question": "Should our community garden install drip irrigation this season or wait until next season?",
  "owner_id": "user_g1",
  "participants": [
    {"agent_id": "member_1", "user_id": "user_g1", "display_name": "Garden member 1", "profile_ref": "profile_garden_1"},

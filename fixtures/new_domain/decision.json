    {"ref": "garden.water_cost_usd_per_month", "value": 140, "unit": "USD/month", "description": "Current monthly water bill"},
    {"ref": "garden.monthly_dues_income", "value": 120, "unit": "USD/month", "description": "Member dues collected each month"}

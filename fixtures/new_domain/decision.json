  ],
  "participant_refs": ["member_1", "member_2"],
  "alternatives": [
    {"id": "install_now", "policy": "install_drip_this_season", "label": "Install drip irrigation now",
     "assumptions": [
       {"ref": "garden.budget_usd", "delta": -1800, "unit": "USD", "description": "Installation cost paid upfront"},
       {"ref": "garden.water_cost_usd_per_month", "value": 60, "unit": "USD/month", "description": "Lower water bill with drip"}
     ]},
    {"id": "install_next_season", "policy": "install_drip_next_season", "label": "Install next season",
     "assumptions": [
       {"ref": "garden.budget_usd", "delta": -1900, "unit": "USD", "at": "+P6M", "description": "Installation (slightly higher quote) in six months"},
       {"ref": "garden.water_cost_usd_per_month", "value": 60, "unit": "USD/month", "at": "+P6M", "description": "Lower water bill from then on"}
     ]}
  ],
  "horizon": {"starts_at": "2026-11-01T00:00:00-07:00", "ends_at": "2027-11-01T00:00:00-07:00"},
  "metrics": ["budget_usd", "budget_runway_months", "plant_yield"],
  "initial_facts": [
